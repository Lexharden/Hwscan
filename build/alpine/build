#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BASE_DIR="$SCRIPT_DIR/base"
WORK_DIR="$SCRIPT_DIR/work"
OUTPUT_DIR="$SCRIPT_DIR/output"
OUTPUT_ISO="$OUTPUT_DIR/hwscan-live-x86_64.iso"
BINARY_PATH="$SCRIPT_DIR/../../dist/hwscan"
WEB_DIR="$SCRIPT_DIR/../../web"

# ── Selección de ISO base Alpine ──────────────────────────────────────────────
# Uso:
#   ./build.sh                         # detecta ISOs en base/ y pregunta
#   ./build.sh alpine-standard-....iso # nombre o ruta a una ISO concreta
#   ALPINE_ISO=ruta/a.iso ./build.sh   # no interactivo
select_alpine_iso() {
    mkdir -p "$BASE_DIR"

    # Argumento / variable de entorno
    if [ -n "${1:-}" ]; then
        if [ -f "$1" ]; then
            ISO_PATH="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"
        elif [ -f "$BASE_DIR/$1" ]; then
            ISO_PATH="$BASE_DIR/$1"
        else
            echo "❌ Error: ISO no encontrada: $1"
            exit 1
        fi
        ISO_NAME="$(basename "$ISO_PATH")"
        return 0
    fi

    if [ -n "${ALPINE_ISO:-}" ]; then
        if [ -f "$ALPINE_ISO" ]; then
            ISO_PATH="$(cd "$(dirname "$ALPINE_ISO")" && pwd)/$(basename "$ALPINE_ISO")"
        elif [ -f "$BASE_DIR/$ALPINE_ISO" ]; then
            ISO_PATH="$BASE_DIR/$ALPINE_ISO"
        else
            echo "❌ Error: ALPINE_ISO no encontrada: $ALPINE_ISO"
            exit 1
        fi
        ISO_NAME="$(basename "$ISO_PATH")"
        return 0
    fi

    # Detectar ISOs Alpine en base/
    mapfile -t DETECTED_ISOS < <(
        find "$BASE_DIR" -maxdepth 1 -type f \( \
            -iname 'alpine*.iso' -o \
            -iname '*alpine*.iso' \
        \) 2>/dev/null | sort
    )

    if [ ${#DETECTED_ISOS[@]} -eq 0 ]; then
        echo "❌ Error: no se encontraron ISOs Alpine en:"
        echo "   $BASE_DIR"
        echo ""
        echo "Coloca ahí una ISO (ej. alpine-standard-3.23.3-x86_64.iso)"
        echo "Descarga: https://alpinelinux.org/downloads/"
        exit 1
    fi

    if [ ${#DETECTED_ISOS[@]} -eq 1 ]; then
        ISO_PATH="${DETECTED_ISOS[0]}"
        ISO_NAME="$(basename "$ISO_PATH")"
        echo "   ISO detectada: $ISO_NAME"
        return 0
    fi

    echo "ISOs Alpine detectadas en base/:"
    echo ""
    local i=1
    for iso in "${DETECTED_ISOS[@]}"; do
        local size
        size=$(du -h "$iso" | cut -f1)
        printf "  [%d] %s  (%s)\n" "$i" "$(basename "$iso")" "$size"
        i=$((i + 1))
    done
    echo ""

    local choice
    while true; do
        read -r -p "Selecciona ISO [1-${#DETECTED_ISOS[@]}]: " choice
        if [[ "$choice" =~ ^[0-9]+$ ]] \
           && [ "$choice" -ge 1 ] \
           && [ "$choice" -le ${#DETECTED_ISOS[@]} ]; then
            break
        fi
        echo "   Opción inválida."
    done

    ISO_PATH="${DETECTED_ISOS[$((choice - 1))]}"
    ISO_NAME="$(basename "$ISO_PATH")"
    echo "   ✓ Seleccionada: $ISO_NAME"
}

# Extrae rama Alpine (ej. 3.23) del nombre de la ISO para los repositorios apk
alpine_branch_from_iso() {
    local name="$1"
    if [[ "$name" =~ ([0-9]+\.[0-9]+)\.[0-9]+ ]]; then
        echo "${BASH_REMATCH[1]}"
    else
        echo "3.23"
    fi
}

echo ""
echo "==================================================="
echo "  HWSCAN Alpine ISO Builder"
echo "==================================================="
echo ""

# [1/6] Verificar dependencias
echo "[1/6] Verificando dependencias..."
missing_deps=()
for cmd in xorriso cpio gzip find tar; do
    if ! command -v $cmd &> /dev/null; then
        missing_deps+=($cmd)
    fi
done

if [ ${#missing_deps[@]} -ne 0 ]; then
    echo "❌ Error: Faltan las siguientes dependencias: ${missing_deps[*]}"
    exit 1
fi
echo "   ✓ Todas las dependencias encontradas"

# [2/6] Seleccionar ISO + verificar binario/web
echo "[2/6] Seleccionando ISO base y verificando archivos..."
select_alpine_iso "${1:-}"
ALPINE_BRANCH="$(alpine_branch_from_iso "$ISO_NAME")"
echo "   Rama Alpine (apk): v${ALPINE_BRANCH}"

if [ ! -f "$BINARY_PATH" ]; then
    echo "❌ Error: binario hwscan no encontrado en: $BINARY_PATH"
    echo "   Ejecuta antes: make build-amd64"
    exit 1
fi

if [ ! -d "$WEB_DIR" ]; then
    echo "❌ Error: directorio web no encontrado en: $WEB_DIR"
    exit 1
fi
echo "   ✓ Archivos verificados (ISO: $ISO_NAME)"

# [3/6] Preparar entorno y extraer ISO base
echo "[3/6] Preparando espacio de trabajo y extrayendo ISO base..."
rm -rf "$WORK_DIR"
mkdir -p "$WORK_DIR/iso"
xorriso -osirrox on -indev "$ISO_PATH" -extract / "$WORK_DIR/iso" 2>&1 | head -1
chmod -R u+w "$WORK_DIR/iso"

# CRÍTICO: el GRUB UEFI embebido (bootx64.efi/efi.img) localiza la ISO con
#   search --set=root --label "<volid de la ISO base>"
# Si cambiamos el label del volumen, UEFI cae al prompt de GRUB.
# Por eso REUTILIZAMOS el volid original de la ISO base.
# Leer el volid directamente del Primary Volume Descriptor (offset 32808, 32 bytes)
BASE_VOLID=$(dd if="$ISO_PATH" bs=1 skip=32808 count=32 2>/dev/null | sed 's/ *$//')
if [ -z "$BASE_VOLID" ]; then
    echo "❌ Error: no se pudo leer el volume id de la ISO base"
    exit 1
fi
echo "   ✓ ISO extraída (volid: '$BASE_VOLID')"

# [4/6] Construir el sistema de archivos RAM (Overlay)
echo "[4/6] Construyendo overlay del sistema de archivos RAM..."
OVERLAY_DIR="$WORK_DIR/overlay"

# Crear estructura de directorios
mkdir -p "$OVERLAY_DIR/usr/bin"
mkdir -p "$OVERLAY_DIR/usr/share/hwscan/web"
mkdir -p "$OVERLAY_DIR/etc/network"
mkdir -p "$OVERLAY_DIR/etc/apk"
mkdir -p "$OVERLAY_DIR/etc/runlevels/sysinit"
mkdir -p "$OVERLAY_DIR/etc/runlevels/boot"
mkdir -p "$OVERLAY_DIR/etc/runlevels/default"
mkdir -p "$OVERLAY_DIR/etc/runlevels/shutdown"
mkdir -p "$OVERLAY_DIR/etc/profile.d"
mkdir -p "$OVERLAY_DIR/root"

# 4.1 Inyectar el binario
cp "$BINARY_PATH" "$OVERLAY_DIR/usr/bin/hwscan"
chmod +x "$OVERLAY_DIR/usr/bin/hwscan"

# 4.2 Copiar archivos de la interfaz web
cp -r "$WEB_DIR"/* "$OVERLAY_DIR/usr/share/hwscan/web/"
echo "   ✓ Binario y archivos web copiados"

# 4.3 Configurar nombre de máquina y red
echo "localhost" > "$OVERLAY_DIR/etc/hostname"
cat > "$OVERLAY_DIR/etc/network/interfaces" << 'EOFNET'
auto lo
iface lo inet loopback

auto eth0
iface eth0 inet dhcp
EOFNET

# 4.4 Activar repositorios online de Alpine (rama detectada desde el nombre de la ISO)
cat > "$OVERLAY_DIR/etc/apk/repositories" << EOFAPK
https://dl-cdn.alpinelinux.org/alpine/v${ALPINE_BRANCH}/main
https://dl-cdn.alpinelinux.org/alpine/v${ALPINE_BRANCH}/community
EOFAPK
echo "   ✓ Repositorios apk: v${ALPINE_BRANCH}"

# 4.5 Auto-login de root en tty1 (sin pedir usuario/contraseña)
# BusyBox getty usa -f para el issue file, NO para autologin: hace falta un wrapper.
mkdir -p "$OVERLAY_DIR/usr/sbin"
cat > "$OVERLAY_DIR/usr/sbin/autologin-root" << 'EOFAUTO'
#!/bin/sh
exec /bin/login -f root
EOFAUTO
chmod +x "$OVERLAY_DIR/usr/sbin/autologin-root"

# tty2-6 quedan con getty normal por si hace falta una shell de emergencia (Alt+F2).
cat > "$OVERLAY_DIR/etc/inittab" << 'EOFINIT'
# /etc/inittab — HWSCAN appliance (auto-login root + hwscan)
::sysinit:/sbin/openrc sysinit
::sysinit:/sbin/openrc boot
::wait:/sbin/openrc default

# tty1: auto-login como root
tty1::respawn:/sbin/getty -n -l /usr/sbin/autologin-root 38400 tty1
tty2::respawn:/sbin/getty 38400 tty2
tty3::respawn:/sbin/getty 38400 tty3
tty4::respawn:/sbin/getty 38400 tty4
tty5::respawn:/sbin/getty 38400 tty5
tty6::respawn:/sbin/getty 38400 tty6

::ctrlaltdel:/sbin/reboot
::shutdown:/sbin/openrc shutdown
EOFINIT
echo "   ✓ Auto-login root configurado en tty1"

# 4.6 Instalar herramientas de hardware al iniciar sesión (necesita red)
cat > "$OVERLAY_DIR/etc/profile.d/install-hw-tools.sh" << 'EOFSH'
#!/bin/sh
# Solo en consolas locales interactivas
case "$-" in *i*) ;; *) return 0 2>/dev/null || exit 0 ;; esac

if ! command -v lspci >/dev/null 2>&1 || ! command -v dmidecode >/dev/null 2>&1; then
    echo -e "\e[36m[*] Instalando herramientas de hardware (lspci/lsusb/dmidecode)...\e[0m"
    # Esperar DHCP un momento; sin red el apk fallará y hwscan seguirá con fallbacks
    i=0
    while [ "$i" -lt 15 ]; do
        if ip route 2>/dev/null | grep -q default; then
            break
        fi
        i=$((i + 1))
        sleep 1
    done
    apk update -q >/dev/null 2>&1
    apk add -q pciutils pciutils-libs hwdata-pci usbutils hwdata-usb dmidecode >/dev/null 2>&1
    if command -v lspci >/dev/null 2>&1; then
        echo -e "\e[32m[✓] Herramientas instaladas correctamente.\e[0m"
    else
        echo -e "\e[31m[!] No se pudieron instalar las herramientas (¿sin red?). Continuando...\e[0m"
    fi
fi
EOFSH
chmod +x "$OVERLAY_DIR/etc/profile.d/install-hw-tools.sh"

# 4.7 Tras el login de root en tty1, lanzar hwscan (sin intervención)
# exec: al salir (Ctrl+C) getty respawnea → auto-login → hwscan otra vez
cat > "$OVERLAY_DIR/root/.profile" << 'EOFPROF'
# HWSCAN: arranque automático en consola principal
if [ -z "$HWSCAN_STARTED" ]; then
    case "$(tty 2>/dev/null)" in
        /dev/tty1|/dev/console)
            export HWSCAN_STARTED=1
            echo ""
            echo -e "\e[36m[*] Iniciando HWSCAN...\e[0m"
            echo ""
            exec /usr/bin/hwscan
            ;;
    esac
fi
EOFPROF
chmod 644 "$OVERLAY_DIR/root/.profile"
echo "   ✓ Arranque automático de hwscan configurado"

# 4.8 Restaurar los servicios por defecto de Alpine
for svc in devfs dmesg mdev hwdrivers modloop; do ln -sf "/etc/init.d/$svc" "$OVERLAY_DIR/etc/runlevels/sysinit/$svc" 2>/dev/null || true; done
for svc in bootmisc hostname hwclock modules swap sysctl syslog termencoding urandom; do ln -sf "/etc/init.d/$svc" "$OVERLAY_DIR/etc/runlevels/boot/$svc" 2>/dev/null || true; done
for svc in networking acpid cron local; do ln -sf "/etc/init.d/$svc" "$OVERLAY_DIR/etc/runlevels/default/$svc" 2>/dev/null || true; done
for svc in killprocs mount-ro savecache; do ln -sf "/etc/init.d/$svc" "$OVERLAY_DIR/etc/runlevels/shutdown/$svc" 2>/dev/null || true; done

# Empaquetar el overlay
cd "$OVERLAY_DIR"
tar -czf "$WORK_DIR/iso/localhost.apkovl.tar.gz" *
cd "$SCRIPT_DIR"
echo "   ✓ Overlay construido (auto-login root + hwscan + herramientas)"

# [5/6] Parchar boot configs (USB dd, QEMU, CD — BIOS y UEFI)
echo "[5/6] Parcheando configuraciones de arranque..."
syslinux_cfg="$WORK_DIR/iso/boot/syslinux/syslinux.cfg"
grub_cfg="$WORK_DIR/iso/boot/grub/grub.cfg"

# NOTA: NO usamos alpine_dev=LABEL:... — el initramfs de Alpine autodetecta
# el medio de arranque, y el label del volumen debe seguir siendo el de la
# ISO base para que el GRUB UEFI embebido encuentre /boot/grub.
KERNEL_ARGS="modules=loop,squashfs,sd-mod,usb-storage quiet modloop=/boot/modloop-lts modloop_verify=no console=tty0"

if [ -f "$syslinux_cfg" ]; then
    cp "$syslinux_cfg" "$syslinux_cfg.bak"
    # Quitar alpine_dev=cdrom:iso9660 si existe — solo busca /dev/sr0
    sed -i 's/ alpine_dev=cdrom:iso9660//g' "$syslinux_cfg"
    if ! grep -q "modloop_verify=no" "$syslinux_cfg"; then
        sed -i "s|\(APPEND.*\)|\1 modloop=/boot/modloop-lts modloop_verify=no console=tty0|" "$syslinux_cfg"
    fi
    echo "   ✓ syslinux.cfg parcheado (BIOS)"
fi

if [ -f "$grub_cfg" ]; then
    cp "$grub_cfg" "$grub_cfg.bak"
    # Alpine 3.24+ usa TAB entre "linux" y "/boot"; el sed por espacio falla.
    # Reescribimos grub.cfg completo para UEFI de forma fiable.
    cat > "$grub_cfg" << EOFGRUB
set timeout=3

menuentry "HWSCAN Live" {
	linux	/boot/vmlinuz-lts ${KERNEL_ARGS}
	initrd	/boot/initramfs-lts
}
EOFGRUB
    echo "   ✓ grub.cfg reescrito (UEFI)"
fi
echo "   ✓ Parámetros de arranque actualizados (BIOS + UEFI)"

# [6/6] Reconstruir ISO
echo "[6/6] Reconstruyendo ISO..."
mkdir -p "$OUTPUT_DIR"
rm -f "$OUTPUT_ISO"

mbr_bin="$WORK_DIR/iso/boot/syslinux/isohdpfx.bin"
if [ ! -f "$mbr_bin" ]; then
    # Extraer el sector MBR directamente desde la ISO base
    dd if="$ISO_PATH" bs=432 count=1 of="$WORK_DIR/isohdpfx.bin" 2>/dev/null
    mbr_bin="$WORK_DIR/isohdpfx.bin"
fi

xorriso -as mkisofs \
    -o "$OUTPUT_ISO" \
    -isohybrid-mbr "$mbr_bin" \
    -c boot/syslinux/boot.cat \
    -b boot/syslinux/isolinux.bin \
    -no-emul-boot \
    -boot-load-size 4 \
    -boot-info-table \
    -eltorito-alt-boot \
    -e boot/grub/efi.img \
    -no-emul-boot \
    -isohybrid-gpt-basdat \
    -V "$BASE_VOLID" \
    -joliet -joliet-long -rational-rock \
    "$WORK_DIR/iso" 2>&1 | grep -i "writing" | head -1

# Limpiar directorio de trabajo temporal
rm -rf "$WORK_DIR"

ISO_SIZE=$(du -h "$OUTPUT_ISO" | cut -f1)

echo ""
echo "==================================================="
echo "  ✓ Construcción completada exitosamente"
echo "==================================================="
echo "Salida: $OUTPUT_ISO"
echo "Tamaño: $ISO_SIZE"
echo "ISO base: $ISO_NAME"
echo ""
echo "Grabar USB (recomendado en Fedora — NO uses Media Writer):"
echo "  # Identifica el USB (ej. /dev/sdb, /dev/sdc). NUNCA uses sda."
echo "  lsblk"
echo "  sudo umount /dev/sdX* 2>/dev/null || true"
echo "  sudo dd if=\"$OUTPUT_ISO\" of=/dev/sdX bs=4M status=progress conv=fsync"
echo "  sync"
echo ""
echo "En la PC objetivo (UEFI):"
echo "  1. Desactiva Secure Boot"
echo "  2. En el menú de arranque elige la entrada USB UEFI (no el disco interno)"
echo ""
echo "Prueba en QEMU (BIOS):"
echo "  qemu-system-x86_64 -cdrom \"$OUTPUT_ISO\" -m 2048 -enable-kvm -nic user,model=e1000"
echo ""
